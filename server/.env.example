# Konfigurasi server. Salin menjadi server/.env (git-ignored; Bun memuatnya saat dijalankan dari folder server/).
# Isi dengan nilai nyata hanya di server/.env; berkas contoh ini TIDAK boleh memuat rahasia.

# MariaDB dev di VPS lewat terowongan SSH (`bun run db:tunnel` membuka 127.0.0.1:33063). Pengguna qc_dev hanya
# berhak atas skema qc_dev; kata sandinya ada di /opt/qc/dev/.env di VPS (kunci QC_DB_PASSWORD).
DATABASE_URL=mysql://qc_dev:GANTI@127.0.0.1:33063/qc_dev

# Rahasia penandatangan cookie sesi (>= 16 karakter acak).
SESSION_SECRET=ganti-dengan-rahasia-acak

# Email super admin.
ADMIN_EMAIL=dev@example.test

# ===== BAGIAN PENGEMBANGAN LOKAL (hanya untuk mesin pengembang) =====
# Login tanpa OAuth lewat /auth/dev-login. WAJIB dikosongkan/dihapus di produksi: server menolak start bila
# DEV_LOGIN_EMAIL terisi dan NODE_ENV=production atau APP_ORIGIN bukan http://localhost / http://127.0.0.1.
# Rutenya juga hanya melayani peer TCP loopback tanpa CF-Connecting-IP (bukan lewat reverse proxy).
# `bun run db:seed` membuat pengguna admin dengan DEV_LOGIN_EMAIL.
DEV_LOGIN_EMAIL=dev@example.test

# Origin publik aplikasi: dasar redirect OAuth Google DAN penentu atribut Secure cookie (tidak diambil dari header
# Host). Dev lewat Vite: http://localhost:3000.
# ===== BAGIAN PRODUKSI (NODE_ENV=production) =====
# Di produksi: NODE_ENV=production, APP_ORIGIN=https://<domain publik> (wajib https; server menolak start bila
# kosong/bukan https), dan JANGAN mengisi DEV_LOGIN_EMAIL.
APP_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Tidak dipakai saat dev-login; nilai palsu cukup di dev. Jembatan Google tidak tersedia lokal.
OAUTH_CLIENT_ID=dev-client-id
OAUTH_CLIENT_SECRET=dev-client-secret
SYNC_API_TOKEN=dev-sync-token-ganti
BRIDGE_URL=http://localhost:9/exec
BRIDGE_SECRET=dev-bridge-secret

# Opsional (nilai bawaan di komentar).
# PORT=8788
# HOST=127.0.0.1            # di dalam kontainer: 0.0.0.0
# TRUSTED_PROXY=loopback    # loopback = percayai CF-Connecting-IP hanya dari peer loopback (nginx); any = dari mana saja
# DB_POOL_SIZE=8            # maks. koneksi pool MariaDB (max_connections VPS = 40)
# STATIC_DIR=               # bawaan server/dist (hasil `bun run build`)
