# Konfigurasi server. Salin menjadi server/.env (git-ignored; Bun memuatnya saat dijalankan dari folder server/).
# Isi dengan nilai nyata hanya di server/.env; berkas contoh ini TIDAK boleh memuat rahasia.

# MariaDB dev di VPS lewat terowongan SSH (`bun run db:tunnel` membuka 127.0.0.1:33063). Pengguna qc_dev hanya
# berhak atas skema qc_dev; kata sandinya ada di /opt/qc/dev/.env di VPS (kunci QC_DB_PASSWORD).
DATABASE_URL=mysql://qc_dev:GANTI@127.0.0.1:33063/qc_dev

# Rahasia penandatangan cookie sesi (>= 16 karakter acak).
SESSION_SECRET=ganti-dengan-rahasia-acak

# Email super admin.
ADMIN_EMAIL=dev@example.test

# ===== BAGIAN PENGEMBANGAN LOKAL (hanya untuk mesin pengembang) =====
# Login tanpa OAuth lewat /auth/dev-login. WAJIB dikosongkan/dihapus di produksi: server menolak start bila
# DEV_LOGIN_EMAIL terisi dan NODE_ENV=production atau APP_ORIGIN bukan http://localhost / http://127.0.0.1.
# Rutenya juga hanya melayani peer TCP loopback tanpa CF-Connecting-IP (bukan lewat reverse proxy).
# `bun run db:seed` membuat pengguna admin dengan DEV_LOGIN_EMAIL.
DEV_LOGIN_EMAIL=dev@example.test

# Origin publik aplikasi: dasar redirect OAuth Google DAN penentu atribut Secure cookie (tidak diambil dari header
# Host). Dev lewat Vite: http://localhost:3000.
# ===== BAGIAN PRODUKSI (NODE_ENV=production) =====
# Di produksi: NODE_ENV=production, APP_ORIGIN=https://<domain publik> (wajib https; server menolak start bila
# kosong/bukan https), dan JANGAN mengisi DEV_LOGIN_EMAIL.
APP_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Tidak dipakai saat dev-login; nilai palsu cukup di dev.
OAUTH_CLIENT_ID=dev-client-id
OAUTH_CLIENT_SECRET=dev-client-secret

# Google Drive/Sheets lokal (OPSIONAL di dev; wajib di produksi): service account, rincian docs/setup-google.md.
# Tanpa ini, unggah berkas/ekspor/QR gagal dengan UNAVAILABLE ("Google belum dikonfigurasi"). Kunci = BERKAS di luar
# repositori (jangan menempelkan isinya di sini). Pakai folder induk UJI sendiri, bukan folder produksi.
# GOOGLE_SA_KEY_FILE=D:/rahasia/qc-google-sa.json
# GOOGLE_ROOT_FOLDER_ID=
# GOOGLE_SPREADSHEET_ID=
# ATTACHMENTS_FOLDER_ID=    # folder fungsi (opsional; kosong = dibuat di bawah folder induk dan dicatat di tabel settings)
# QR_FOLDER_ID=
# QR_DOC_FOLDER_ID=
# BACKUP_FOLDER_ID=
# DESKTOP_RELEASES_FOLDER_ID=   # folder rilis desktop (opsional; kosong = pembaruan desktop nonaktif)
# ALLOWED_FOLDER_IDS=       # folder tambahan di luar induk, dipisah koma

# Peringatan email (SMTP generik, T32); kosong = dinonaktifkan. Cadangan malam hanya berjalan di produksi.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false         # true untuk port 465 (TLS langsung)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ALERT_TO=                 # penerima, dipisah koma
# Web Push notifikasi Serah Terima (kunci VAPID base64url); kosong = push dinonaktifkan.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=            # mailto:... atau https://...; kosong = APP_ORIGIN bila https
# DESKTOP_CATALOG_TOKEN=    # token bersama katalog Tipe offline desktop (>= 32 karakter); kosong = rute /api/desktop/catalog dinonaktifkan
# QUOTA_ALERT_PERCENT=80    # ambang peringatan kuota Drive (1-99)
# BACKUP_ENABLED=           # kosong/true = cadangan terjadwal hidup di produksi; false = mati (staging)
# BACKUP_LOCAL_DIR=         # folder dump lokal (bawaan /var/backups/qc di produksi, folder sementara OS di dev)
# PROOF_STAGING_DIR=        # folder sementara foto bukti QC Serial Number (bawaan /var/lib/qc/proofs di produksi, ./data/proofs di dev)
# PROOF_STAGING_MAX_BYTES=  # batas total berkas sementara foto bukti, byte (bawaan 2147483648 = 2 GiB)

# Opsional (nilai bawaan di komentar).
# PORT=8788
# HOST=127.0.0.1            # di dalam kontainer: 0.0.0.0
# TRUSTED_PROXY=127.0.0.1/32,::1/128   # daftar CIDR peer yang CF-Connecting-IP-nya dipercaya (bawaan loopback); di Docker: subnet compose
# DB_POOL_SIZE=8            # maks. koneksi pool MariaDB (max_connections VPS = 40)
# STATIC_DIR=               # bawaan server/dist (hasil `bun run build`)
