# Variabel pengembangan lokal untuk `wrangler dev`. Salin menjadi server/.dev.vars (tidak masuk git).
# JANGAN pernah memasukkan nilai ini ke wrangler.jsonc atau rahasia produksi.

# Email yang dipakai /auth/dev-login (hanya aktif di localhost/127.0.0.1). Isi dengan email Anda;
# `bun run db:seed` membuatnya sebagai admin.
DEV_LOGIN_EMAIL=dev@example.test
ADMIN_EMAIL=dev@example.test

SESSION_SECRET=ganti-dengan-rahasia-acak
APP_ORIGIN=http://localhost:8787

# Tidak dipakai saat dev-login; nilai palsu cukup.
OAUTH_CLIENT_ID=dev-client-id
OAUTH_CLIENT_SECRET=dev-client-secret
SYNC_API_TOKEN=dev-sync-token
BRIDGE_URL=http://localhost:9/exec
BRIDGE_SECRET=dev-bridge-secret
