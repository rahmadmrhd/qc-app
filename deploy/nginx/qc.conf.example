# nginx untuk qc-app (staging dan production) di VPS bersama. CONTOH: salin tiap blok `server {}` ke berkasnya sendiri
# (mis. /etc/nginx/sites-available/qc-dev.rhd.my.id), tiru situs lain di server itu (jalur sertifikat, gaya),
# lalu aktifkan dengan symlink ke sites-enabled. Prosedur lengkap, urutan, dan pembatalan: docs/deploy-vps.md.
# Wajib `nginx -t` lulus sebelum `nginx -s reload`; jangan menyentuh blok situs lain.
#
# Lalu lintas: Browser/QC Desktop -> Cloudflare (proxy, Full strict) -> nginx 443 -> 127.0.0.1:APP_PORT (qc-app).
# - Placeholder ISI_... SENGAJA tidak valid agar `nginx -t` gagal bila belum diganti.
# - Port: staging 8790 dan production 8791 (= APP_PORT di .env masing-masing; 8787 dilarang, dipakai aplikasi lain).
# - Sertifikat origin harus mencakup hostname server ini (Cloudflare Origin CA atau sertifikat situs lain bila mencakup).
# - client_max_body_size: batas badan terbesar server (rute biner terbesar di shared/api.ts, kini 10 MiB, dan batas
#   10 MiB berkas/gambar sesudah T30a) + overhead multipart/HTTP; di atasnya nginx membalas 413. Server sendiri
#   membatasi tiap rute (server/src/http/body.ts); jaga angka ini >= MAX_REQUEST_BODY_BYTES (dijaga
#   server/src/deploy-files.test.ts).
# - Daftar `set_real_ip_from` = rentang IP Cloudflare per penyusunan contoh ini; SELALU ambil yang terbaru dari
#   https://www.cloudflare.com/ips-v4 dan https://www.cloudflare.com/ips-v6 saat memasang. Dengan real_ip,
#   $remote_addr = IP klien asli hanya untuk permintaan yang datang dari rentang itu; dari sumber lain
#   $remote_addr tetap alamat peer sebenarnya. nginx lalu MENIMPA header CF-Connecting-IP ke qc-app dengan
#   $remote_addr, jadi nilai yang dikirim klien tak pernah sampai ke aplikasi. qc-app mempercayai header itu
#   hanya dari peer di TRUSTED_PROXY (gateway bridge compose + loopback).

# ---------------------------------------------------------------------------------------------------------------
# STAGING: qc-dev.rhd.my.id  (Universal SSL Cloudflare hanya mencakup satu tingkat di bawah rhd.my.id, jadi bukan
# qc.dev.rhd.my.id)
# ---------------------------------------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name qc-dev.rhd.my.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name qc-dev.rhd.my.id;

    ssl_certificate     ISI_JALUR_SERTIFIKAT_ORIGIN_DI_SINI.pem;
    ssl_certificate_key ISI_JALUR_KUNCI_PRIVAT_DI_SINI.key;

    server_tokens off;
    client_max_body_size 11m;
    client_body_timeout 60s;

    # IP klien asli dari Cloudflare (hanya dipercaya bila peer termasuk rentang di bawah).
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Menimpa nilai kiriman klien: yang sampai ke qc-app selalu $remote_addr hasil real_ip di atas.
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
}

# ---------------------------------------------------------------------------------------------------------------
# PRODUCTION: qc.rhd.my.id  (JANGAN diaktifkan sebelum lingkungan production siap dan cutover; ditulis di sini agar
# bentuknya sudah tertinjau)
# ---------------------------------------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name qc.rhd.my.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name qc.rhd.my.id;

    ssl_certificate     ISI_JALUR_SERTIFIKAT_ORIGIN_DI_SINI.pem;
    ssl_certificate_key ISI_JALUR_KUNCI_PRIVAT_DI_SINI.key;

    server_tokens off;
    client_max_body_size 11m;
    client_body_timeout 60s;

    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;

    location / {
        proxy_pass http://127.0.0.1:8791;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
}
