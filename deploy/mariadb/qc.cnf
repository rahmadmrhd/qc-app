[mysqld]
character-set-server=utf8mb4
collation-server=utf8mb4_nopad_bin
innodb_buffer_pool_size=128M
# Cache Aria (hasil antara kueri GROUP BY/UNION besar yang melewati tmp_table_size dan ditulis ke disk) dibatasi 32M. Bawaan 128M:
# satu kueri besar mengisi seluruh cache dan memorinya tak dilepas lagi; kontainer qc-db dibatasi 384M (compose.yml), jadi pada produksi
# ~365M sudah berpindah ke swap dan swap host hampir penuh (diukur 2026-11-22; uji sintetis staging: +141 MB pada 128M vs +62 MB pada 32M).
# Variabel ini READ-ONLY (SET GLOBAL ditolak, ERROR 1238): berlaku hanya setelah `docker restart <qc-db>`. Rinci: docs/ci-cd.md.
aria_pagecache_buffer_size=32M
max_connections=40
# JANGAN menambahkan NO_BACKSLASH_ESCAPES: mysql2 meng-escape nilai di sisi klien dengan backslash, dan mode itu
# membuat escaping salah (injeksi SQL). Lihat komentar `checkBindValue` di server/src/core/db.ts.
sql_mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
