# Salin menjadi .env di folder compose (<INSTALL_DIR>/<staging|production>/.env, chmod 600; di VPS pribadi: /root/apps/qc-app/<env>/.env). Jangan di-commit.
# Contoh di bawah untuk staging (qc-dev.rhd.my.id); production (qc.rhd.my.id) memakai nilai di komentar.
# Berkas contoh ini TIDAK memuat rahasia: semua nilai "ganti-..." diisi di VPS.
# Kata sandi/rahasia: pakai heksa atau alfanumerik (`openssl rand -hex 24`); hindari `$`, `@`, `:`, `/`, `#`
# karena dibaca compose (interpolasi `$`) dan disusun ke dalam DATABASE_URL.
# Tulis nilai TANPA kutip (disarankan). deploy.sh dan compose sama-sama membuang satu pasang kutip yang cocok, tetapi
# kutip tak tertutup merusak penguraian compose dan galatnya dapat memuat potongan nilai.

# ===== Lingkungan dan infrastruktur (dibaca compose) =====
# Nama lingkungan = nama folder (staging atau production).
QC_ENV=staging
# Awalan nama proyek/kontainer/jaringan/volume; bawaan qc-${QC_ENV} (staging: qc-staging; stack dev lama T1
# memakai qc-dev, jadi tak bertabrakan). Production: qc-production (bawaan).
# QC_NAME=qc-staging
# Port host (hanya 127.0.0.1): MariaDB untuk tunnel SSH, dan aplikasi untuk nginx host (harus sama dengan proxy_pass di
# nginx). Periksa `ss -ltn` sebelum memilih; 8787 dilarang. Staging: DB 33064 (33063 = stack dev lama) dan APP 8790;
# production: DB 33065 dan APP 8791.
DB_PORT=33064
APP_PORT=8790
MARIADB_ROOT_PASSWORD=ganti-dengan-acak
QC_DB_PASSWORD=ganti-dengan-acak
QC_TEST_DB_PASSWORD=ganti-dengan-acak
# Pengguna dan skema aplikasi; bawaan qc_${QC_ENV} (production: qc_production).
# Contoh ini untuk STAGING, yang WAJIB mengisinya eksplisit: skema staging yang sudah berisi data bernama qc_dev (bukan qc_staging).
# PRODUCTION: HAPUS dua baris berikut (QC_DB_USER dan QC_DB_NAME) agar bawaan qc_production dipakai.
QC_DB_USER=qc_dev
QC_DB_NAME=qc_dev

# Image aplikasi: tag SHA dari GHCR (diisi skrip deploy, T27/T28).
# QC_IMAGE=ghcr.io/rahmadmrhd/qc-app
QC_IMAGE_TAG=ganti-dengan-tag-sha
# Jumlah tag image terbaru yang disimpan deploy.sh saat membersihkan image lama setelah deploy sukses (1-99; bawaan 3).
# Hanya dibaca deploy.sh, tidak diteruskan ke kontainer. Tag terpakai, tag sebelumnya, dan tag lingkungan lain selalu aman.
# QC_KEEP_IMAGES=3

# Subnet jaringan compose, DIPATOK (lihat komentar di compose.yml). Satu subnet per lingkungan dan tidak boleh
# bertabrakan dengan jaringan Docker lain di VPS (`docker network inspect`): staging 10.77.10.0/24, production 10.77.20.0/24.
QC_SUBNET=10.77.10.0/24

# Direktori berkas rahasia di host; bawaan ./secrets (relatif terhadap folder compose, jadi <INSTALL_DIR>/<env>/secrets).
# Berkas google-sa.json (izin 600) disalin pemilik ke sini, tidak lewat GitHub, dan dipasang baca-saja ke /run/secrets/google-sa.json.
# QC_SECRETS_DIR=/srv/qc-app/staging/secrets   # hanya bila ingin jalur lain (mutlak, atau relatif ke folder compose)

# ===== Aplikasi (diteruskan ke qc-app; daftar eksplisit di compose.yml) =====
# Origin publik (wajib https): dasar redirect OAuth dan atribut Secure cookie. Staging: https://qc-dev.rhd.my.id;
# production: https://qc.rhd.my.id (URI redirect OAuth = <origin>/auth/callback, didaftarkan pemilik).
APP_ORIGIN=https://qc-dev.rhd.my.id
# Daftar CIDR peer yang CF-Connecting-IP-nya dipercaya: loopback + subnet compose (QC_SUBNET). Peer nginx host
# terlihat sebagai gateway bridge (alamat pertama subnet), bukan loopback. Jangan memakai 0.0.0.0/0.
# (production: ganti entri terakhir dengan QC_SUBNET production, mis. 10.77.20.0/24)
TRUSTED_PROXY=127.0.0.1/32,::1/128,10.77.10.0/24
SESSION_SECRET=ganti-dengan-acak-min-16-karakter
# OAUTH_*, SMTP_*, GOOGLE_*: milik pemilik; di VPS isi placeholder ISI_OLEH_PEMILIK sampai pemilik mengisinya.
OAUTH_CLIENT_ID=ganti-dengan-client-id
OAUTH_CLIENT_SECRET=ganti-dengan-client-secret
SYNC_API_TOKEN=ganti-dengan-acak-min-16-karakter
ADMIN_EMAIL=ganti-dengan-email-super-admin

# Klien Google langsung (service account, T30a; menggantikan jembatan Apps Script). Rincian: docs/setup-google.md.
# Jalur DI DALAM kontainer; berkas kunci dipasang baca-saja dari host (QC_SECRETS_DIR/google-sa.json).
GOOGLE_SA_KEY_FILE=/run/secrets/google-sa.json
# Id folder induk Drive (dibagikan ke service account sebagai Editor); folder baru selalu dibuat di bawahnya.
GOOGLE_ROOT_FOLDER_ID=
# Id spreadsheet data tunggal (dibagikan ke service account sebagai Editor): ekspor/impor Sheets.
GOOGLE_SPREADSHEET_ID=
# Folder fungsi (opsional): kosong = dibuat otomatis di bawah folder induk dan dicatat di tabel settings.
# Bila diisi, id itulah yang dipakai (hanya diverifikasi, tidak pernah dibuat/ditimpa).
# ATTACHMENTS_FOLDER_ID = folder lampiran: semua berkas di tabel files (gambar item dan lampiran lain), di luar PDF sumber QR dan hasil ekspor QR.
ATTACHMENTS_FOLDER_ID=
QR_FOLDER_ID=
QR_DOC_FOLDER_ID=
BACKUP_FOLDER_ID=
# Folder tambahan di luar folder induk yang boleh disentuh klien Google (id dipisah koma); biasanya kosong.
ALLOWED_FOLDER_IDS=

# Email peringatan (SMTP generik, T32): cadangan basi dan kuota Drive. Pindah penyedia = ganti nilai di sini saja.
# Bila salah satu kosong/tidak valid, peringatan dinonaktifkan (dicatat di log), aplikasi tetap berjalan.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=
# Cadangan terjadwal: kosong atau true = hidup (produksi); false = mati. WAJIB false di staging bila BACKUP_FOLDER_ID sama dengan production
# (nama berkas tak memuat lingkungan dan retensi menyimpan satu berkas per hari: dump staging dapat menggantikan dump production).
# Pemulihan (restore-backup.ts) tetap bisa membaca folder cadangan walau false.
BACKUP_ENABLED=
# Ambang peringatan pemakaian kuota Drive (persen, 1-99); kosong = 80.
QUOTA_ALERT_PERCENT=80
