{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "bun"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "@worker/*": ["./src/*"],
      "@worker-test/*": ["./test-support/*"],
      "@bridge/*": ["../bridge/src/*"],
      "@bridge-test/*": ["../bridge/test-support/*"]
    }
  },
  "include": ["src", "test-support", "migrations", "../shared/*.ts", "scripts"]
}
