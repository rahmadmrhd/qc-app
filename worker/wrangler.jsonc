{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "2256d27ce4dcdcb9ade777cc2650fd81",
  "name": "app",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    // Keluaran build web (Vite outDir ../worker/dist), berpotongan.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Daftar pola (bukan true): aset dan navigasi rute klien dilayani tanpa Worker/CPU.
    "run_worker_first": ["/api/*", "/auth/*", "/sync"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qc-app-production",
      "database_id": "cf7f9bb3-202d-4819-bc1f-c60581795933",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "qc-app-jobs-production" }],
    "consumers": [{ "queue": "qc-app-jobs-production" }]
  },
  // Cron hanya menjadwalkan pembersihan (pesan antrean); kerja berat di consumer. Tiap env mendefinisikan sendiri.
  "triggers": { "crons": ["0 * * * *"] },
  // Cache isi berkas di R2 (OPSIONAL, Spek 8.4). R2 belum diaktifkan di akun: JANGAN buka komentar sebelum
  // diaktifkan (deploy gagal bila binding aktif). Cara: dashboard Cloudflare > R2 > aktifkan; buat bucket
  // (`wrangler r2 bucket create qc-app-files-production` dan `qc-app-files-staging`); lalu buka komentar
  // blok di bawah (produksi di sini, staging di dalam "env.staging") dan deploy. Tanpa binding perilaku
  // sama seperti sebelumnya (Cache API). Objek `f/<driveId>`; aman dikosongkan kapan pun.
  // "r2_buckets": [{ "binding": "FILES_CACHE", "bucket_name": "qc-app-files-production" }],
  "env": {
    "staging": {
      // "r2_buckets": [{ "binding": "FILES_CACHE", "bucket_name": "qc-app-files-staging" }],
      // Staging di akun Cloudflare TERPISAH (keputusan pemilik 2026-10-25): kuota D1 gratis berlaku per akun,
      // jadi uji beban staging tidak boleh memakan jatah produksi di akun "QC".
      "account_id": "0c513cf2ea5fc5f24a06c6725e224400",
      "name": "app-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qc-app-staging",
          "database_id": "f1161b5c-a26f-44f1-a99e-c3bd88dfd271",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["0 * * * *"] },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "qc-app-jobs-staging" }],
        "consumers": [{ "queue": "qc-app-jobs-staging" }]
      }
    }
  }
}
