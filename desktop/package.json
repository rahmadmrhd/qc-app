{
  "name": "@qc/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QC App desktop (Electron): Country Lock dan penampil UI web",
  "author": "QC",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "pack": "bun run build && electron-builder --dir --config electron-builder.yml",
    "dist": "bun run build && electron-builder --config electron-builder.yml",
    "verify-pack": "bun run scripts/verify-pack.ts",
    "spike": "bun run spike/hardware-spike.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
