{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@gas/*": ["../gas/src/*"],
      "@gas-test/*": ["../gas/test-support/*"]
    }
  },
  "include": ["src"]
}
